+    cs: r.compositeScore,
+    f: FACTORS.map((fac) => r.factorScores[fac.id]),
+    a: [r.axisScores.strategy, r.axisScores.risk, r.axisScores.trust, r.axisScores.motive],
+  };
+}
+
+export function shareInputFromSnapshot(s: ResultSnapshot): ShareInput {
+  return { c: s.c, cs: s.cs, f: s.f, a: s.a };
+}
+
+// 복호화된 임의 객체를 검증 → 유효하면 ResultSnapshot, 아니면 null (변조·손상 방어)
+export function parseSnapshot(obj: unknown): ResultSnapshot | null {
+  if (!obj || typeof obj !== "object") return null;
+  const o = obj as Record<string, unknown>;
+  const numArr = (x: unknown, n: number) =>
+    Array.isArray(x) && x.length === n && x.every((v) => typeof v === "number" && v >= 1 && v <= 5);
+  if (o.v !== SNAPSHOT_FORMAT) return null;
+  if (typeof o.qv !== "string" || typeof o.sv !== "string") return null;
+  if (typeof o.c !== "string" || !VALID_CODES.has(o.c)) return null;
+  if (typeof o.cs !== "number" || o.cs < 0 || o.cs > 100) return null;
+  if (!numArr(o.f, FACTORS.length) || !numArr(o.a, 4)) return null;
+  if (typeof o.t !== "number") return null;
+  return { v: o.v, qv: o.qv, sv: o.sv, c: o.c, cs: o.cs, f: o.f as number[], a: o.a as number[], t: o.t };
+}
+
+// 클라이언트 입력 검증 (서버 액션에서 사용)
+export function validateShareInput(obj: unknown): ShareInput | null {
+  if (!obj || typeof obj !== "object") return null;
+  const o = obj as Record<string, unknown>;
+  const numArr = (x: unknown, n: number) =>
+    Array.isArray(x) && x.length === n && x.every((v) => typeof v === "number" && v >= 1 && v <= 5);
+  if (typeof o.c !== "string" || !VALID_CODES.has(o.c)) return null;
+  if (typeof o.cs !== "number" || o.cs < 0 || o.cs > 100) return null;
+  if (!numArr(o.f, FACTORS.length) || !numArr(o.a, 4)) return null;
+  return { c: o.c, cs: o.cs, f: o.f as number[], a: o.a as number[] };
+}
+
+// 스냅샷 → 화면 렌더용 결과 (computeResult와 동일 형태)
+export function resultFromSnapshot(s: ResultSnapshot) {
+  const factorScores = Object.fromEntries(
+    FACTORS.map((fac, i) => [fac.id, s.f[i]]),
+  ) as Record<FactorId, number>;
+  const type = TYPES.find((t) => t.code === s.c) ?? TYPES[0];
+  return {
+    code: s.c,
+    type,
+    factorScores,
+    axisScores: { strategy: s.a[0], risk: s.a[1], trust: s.a[2], motive: s.a[3] },
+    compositeScore: s.cs,
+  };
+}
