@@ -0,0 +1,63 @@
+import "server-only";
+import type { ResultSnapshot } from "./financialDna";
+
+// 서버 전용 AES-256-GCM 인증 암호화. 키는 SHARE_SECRET(base64 32바이트) 환경변수에만 존재하며
+// 클라이언트 번들에 포함되지 않는다. 토큰이 변조·잘림·손상되면 복호화가 실패해 null을 반환한다.
+
+const IV_LEN = 12; // GCM 표준 nonce 길이
+const FORMAT_BYTE = 1; // 토큰 바이너리 포맷 버전
+const MAX_TOKEN_LEN = 4000; // 비정상적으로 긴 입력 방어
+
+function b64urlEncode(bytes: Uint8Array): string {
+  return Buffer.from(bytes)
+    .toString("base64")
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+}
+
+function b64urlDecode(s: string): Uint8Array {
+  const pad = s.length % 4 === 0 ? "" : "=".repeat(4 - (s.length % 4));
+  const b64 = s.replace(/-/g, "+").replace(/_/g, "/") + pad;
+  return new Uint8Array(Buffer.from(b64, "base64"));
+}
+
+async function importKey(): Promise<CryptoKey> {
+  const secret = process.env.SHARE_SECRET;
+  if (!secret) throw new Error("SHARE_SECRET is not configured");
+  const raw = new Uint8Array(Buffer.from(secret, "base64"));
+  if (raw.length !== 32) throw new Error("SHARE_SECRET must decode to 32 bytes");
+  return crypto.subtle.importKey("raw", raw, { name: "AES-GCM" }, false, ["encrypt", "decrypt"]);
+}
+
+export async function encryptSnapshot(snapshot: ResultSnapshot): Promise<string> {
+  const key = await importKey();
+  const iv = crypto.getRandomValues(new Uint8Array(IV_LEN));
+  const plaintext = new TextEncoder().encode(JSON.stringify(snapshot));
+  const ct = new Uint8Array(
+    await crypto.subtle.encrypt({ name: "AES-GCM", iv }, key, plaintext),
+  );
+  const packed = new Uint8Array(1 + IV_LEN + ct.length);
+  packed[0] = FORMAT_BYTE;
+  packed.set(iv, 1);
+  packed.set(ct, 1 + IV_LEN);
+  return b64urlEncode(packed);
+}
+
+// 변조/잘림/잘못된 문자/과도한 길이 모두 null 로 안전 처리한다.
+export async function decryptToken(token: string | undefined | null): Promise<unknown | null> {
+  try {
+    if (!token || token.length > MAX_TOKEN_LEN) return null;
+    if (!/^[A-Za-z0-9_-]+$/.test(token)) return null;
+    const packed = b64urlDecode(token);
+    if (packed.length < 1 + IV_LEN + 16) return null; // 최소 헤더 + GCM 태그
+    if (packed[0] !== FORMAT_BYTE) return null;
+    const iv = packed.slice(1, 1 + IV_LEN);
+    const ct = packed.slice(1 + IV_LEN);
+    const key = await importKey();
+    const pt = await crypto.subtle.decrypt({ name: "AES-GCM", iv }, key, ct);
+    return JSON.parse(new TextDecoder().decode(new Uint8Array(pt)));
+  } catch {
+    return null;
+  }
+}
