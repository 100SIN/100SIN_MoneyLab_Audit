+// 답변을 URL에 담을 수 있는 96자리 문자열로 인코딩/디코딩한다.
+// 문항 id(1~96)는 셔플과 무관하게 항상 고정이므로, 링크를 통해
+// 새로고침·공유해도 항상 동일한 결과가 재현된다. 서버 저장소 없이도
+// "결과 저장·공유"를 만족시키기 위한 선택.
+export function encodeAnswers(answers: Record<number, number>): string | null {
+  let out = "";
+  for (const qu of QUESTIONS) {
+    const value = answers[qu.id];
+    if (!value || value < 1 || value > 5) return null;
+    out += String(value);
+  }
+  return out;
+}
+
+export function decodeAnswers(code: string): Record<number, number> | null {
+  if (!/^[1-5]{96}$/.test(code)) return null;   // 형식·길이·범위 검증 → 잘못된 값은 null
+  const answers: Record<number, number> = {};
+  QUESTIONS.forEach((qu, i) => {
+    answers[qu.id] = Number(code[i]);
+  });
+  return answers;
+}
#
# 설명: encodeAnswers/decodeAnswers 는 채점 가중치를 전혀 노출하지 않는다.
#       단지 "답변 1~5" 배열을 URL 문자열로 왕복 변환할 뿐이며, 정규식
#       /^[1-5]{96}$/ 로 형식·길이·범위를 검증해 잘못된 파라미터를 차단한다.


