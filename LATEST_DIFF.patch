@@ -0,0 +1,32 @@
+"use server";
+
+import {
+  validateShareInput,
+  QUESTIONNAIRE_VERSION,
+  SCORING_VERSION,
+  SNAPSHOT_FORMAT,
+  type ResultSnapshot,
+} from "@/lib/financialDna";
+import { encryptSnapshot } from "@/lib/shareToken";
+
+// 클라이언트가 계산한 결과(유형 코드·점수)를 받아 서버에서 버전/시각을 스탬프하고
+// AES-GCM 암호화 토큰을 만든다. 원본 96개 응답은 전송되지 않으며, 실패 시 null 반환.
+export async function createShareToken(input: unknown): Promise<string | null> {
+  const valid = validateShareInput(input);
+  if (!valid) return null;
+  try {
+    const snapshot: ResultSnapshot = {
+      v: SNAPSHOT_FORMAT,
+      qv: QUESTIONNAIRE_VERSION,
+      sv: SCORING_VERSION,
+      c: valid.c,
+      cs: valid.cs,
+      f: valid.f,
+      a: valid.a,
+      t: Date.now(),
+    };
+    return await encryptSnapshot(snapshot);
+  } catch {
+    return null;
+  }
+}
